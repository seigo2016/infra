---
# Example secrets file. Copy to vault.yml and encrypt with:
#   ansible-vault encrypt ansible/group_vars/research-ops-cp/vault.yml
# Keep a second copy of every value in KeePassXC (see
# docs/standards/research-ops-cp-restore.md). Without the pgBackRest cipher
# pass and an R2 key the backups cannot be restored.
#
# vault_research_ops_db_password:  openssl rand -hex 32  (alphanumeric only)
# vault_research_ops_cloudflared_tunnel_token:
#     terraform -chdir=terraform/cloudflare output -raw tunnel_token
# vault_research_ops_access.actors: people only (verified email -> short name). Service tokens,
#     the team domain and the audience are read from terraform/cloudflare's state by the playbook.
# vault_r2_account_id: Cloudflare account ID (R2 endpoint host)
# vault_pgbackrest_s3_key / _secret: R2 API token, Object Read & Write,
#     scoped to the research-ops-cp-backup bucket only. Used by pgBackRest
#     (backup, archive-push, expire) and by the weekly pg_dump upload.
# vault_pgbackrest_restore_s3_key / _secret: R2 API token, Object Read only,
#     same bucket. Used by the restore rehearsal VM.
# vault_pgbackrest_cipher_pass: openssl rand -base64 48  (repository cipher)
# vault_pg_dump_crypt_password / _salt: high-entropy strings for the rclone
#     crypt remote that encrypts the pg_dump copies.

vault_research_ops_db_password: "REPLACE_ME_64_HEX_CHARS"
vault_research_ops_cloudflared_tunnel_token: "REPLACE_ME_FROM_TERRAFORM_OUTPUT"
vault_research_ops_access:
  team_domain: "https://REPLACE_ME_TEAM.cloudflareaccess.com"
  aud: "REPLACE_ME_ACCESS_AUD"
  actors:
    REPLACE_ME_CLIENT_ID.access: bridge-1
vault_r2_account_id: "REPLACE_ME_CLOUDFLARE_ACCOUNT_ID"
vault_pgbackrest_s3_key: "REPLACE_ME_R2_ACCESS_KEY_READ_WRITE"
vault_pgbackrest_s3_key_secret: "REPLACE_ME_R2_SECRET_KEY_READ_WRITE"
vault_pgbackrest_restore_s3_key: "REPLACE_ME_R2_ACCESS_KEY_READ_ONLY"
vault_pgbackrest_restore_s3_key_secret: "REPLACE_ME_R2_SECRET_KEY_READ_ONLY"
vault_pgbackrest_cipher_pass: "REPLACE_ME_HIGH_ENTROPY"
vault_pg_dump_crypt_password: "REPLACE_ME_HIGH_ENTROPY"
vault_pg_dump_crypt_salt: "REPLACE_ME_HIGH_ENTROPY"

# TOTP secret for approving host operations (base32; the PI creates it in KeePassXC).
vault_research_ops_totp_secret: "<base32 secret from KeePassXC>"

# Optional exact observation bindings. Each host is a Bridge actor, not an SSH host.
# vault_research_ops_overview_project_roots:
#   - host: "bridge-example"
#     root: "/path/to/checkout"
#     project_id: "00000000-0000-4000-8000-000000000001"
